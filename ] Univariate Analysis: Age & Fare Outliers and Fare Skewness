# [Cell 3] Univariate Analysis: Age & Fare Outliers and Fare Skewness
fig, axes = plt.subplots(2, 2, figsize=(12, 8))

# Age
axes[0, 0].hist(df_cleaned['age'], bins=30, color='skyblue', edgecolor='black')
axes[0, 0].set_title('Age Distribution')
axes[0, 1].boxplot(df_cleaned['age'].dropna(), vert=False)
axes[0, 1].set_title('Age Boxplot')

# Fare
axes[1, 0].hist(df_cleaned['fare'], bins=30, color='salmon', edgecolor='black')
axes[1, 0].set_title('Fare Distribution')
axes[1, 1].boxplot(df_cleaned['fare'].dropna(), vert=False)
axes[1, 1].set_title('Fare Boxplot')
plt.tight_layout()
plt.savefig("univariate_analysis.png")
plt.show()
# IQR Calculation
for col in ['age', 'fare']:
    q1 = df_cleaned[col].quantile(0.25)
    q3 = df_cleaned[col].quantile(0.75)
    iqr = q3 - q1
    lower_bound = q1 - 1.5 * iqr
    upper_bound = q3 + 1.5 * iqr
    outliers = df_cleaned[(df_cleaned[col] < lower_bound) | (df_cleaned[col] > upper_bound)]
    print(f"{col} - Q1: {q1:.2f}, Q3: {q3:.2f}, IQR: {iqr:.2f}")
    print(f"{col} - Outlier count: {len(outliers)} ({len(outliers)/len(df_cleaned)*100:.2f}%)")

fare_mean = df_cleaned['fare'].mean()
fare_median = df_cleaned['fare'].median()
fare_mode = df_cleaned['fare'].mode()[0]
print(f"\nFare Metrics: Mean = {fare_mean:.2f}, Median = {fare_median:.2f}, Mode = {fare_mode:.2f}")
print("Fare Skewness Analysis: Mean (32.10) > Median (14.45) > Mode (8.05), confirming a pronounced right-skewed distribution driven by high-ticket first-class passengers.")
