import os
import re
import sqlite3
import pandas as pd
import requests
from bs4 import BeautifulSoup

# Fixed project baseline conversion constant
GBP_TO_INR_RATE = 105.50

RATING_MAP = {
    "one": 1,
    "two": 2,
    "three": 3,
    "four": 4,
    "five": 5
}

BASE_URL = "https://books.toscrape.com/"

def scrape_books(min_count=60):
    scraped_data = []
    page = 1
    
    while len(scraped_data) < min_count and page <= 50:
        url = f"{BASE_URL}catalogue/page-{page}.html"
        resp = requests.get(url, timeout=10)
        if resp.status_code != 200:
            break
            
        soup = BeautifulSoup(resp.content, "html.parser")
        articles = soup.find_all("article", class_="product_pod")
        if not articles:
            break
            
        for art in articles:
            # Title
            h3_tag = art.find("h3")
            title = h3_tag.find("a")["title"] if h3_tag and h3_tag.find("a") else "Unknown"
            
            # Price raw string (e.g., £51.77)
            price_elem = art.find("p", class_="price_color")
            raw_price = price_elem.text.strip() if price_elem else None
            
            # Rating class (e.g., ["star-rating", "Three"])
            rating_elem = art.find("p", class_=re.compile(r"star-rating\s*"))
            raw_rating = None
            if rating_elem:
                classes = [c.lower() for c in rating_elem.get("class", []) if c.lower() != "star-rating"]
                raw_rating = classes[0] if classes else None
                
            # Availability text
            avail_elem = art.find("p", class_="instock availability")
            raw_avail = avail_elem.text.strip() if avail_elem else None
            
            # Fetch book page to get category
            rel_link = art.find("h3").find("a")["href"]
            detail_url = BASE_URL + "catalogue/" + rel_link
            category = "Default"
            try:
                detail_resp = requests.get(detail_url, timeout=10)
                if detail_resp.status_code == 200:
                    detail_soup = BeautifulSoup(detail_resp.content, "html.parser")
                    breadcrumb = detail_soup.find("ul", class_="breadcrumb")
                    if breadcrumb:
                        crumbs = breadcrumb.find_all("li")
                        if len(crumbs) >= 3:
                            category = crumbs[2].text.strip()
            except Exception:
                pass

            scraped_data.append({
                "title": title,
                "raw_price": raw_price,
                "raw_rating": raw_rating,
                "raw_avail": raw_avail,
                "category": category
            })
            
            if len(scraped_data) >= min_count:
                break
        page += 1
        
    return pd.DataFrame(scraped_data)

def clean_data(df):
    cleaned = df.copy()
    
    # 1. Clean price_gbp
    def parse_price(val):
        if not val or pd.isna(val):
            return None
        cleaned_str = re.sub(r"[^\d.]", "", str(val))
        try:
            return float(cleaned_str)
        except ValueError:
            return None
            
    cleaned["price_gbp"] = cleaned["raw_price"].apply(parse_price)
    # Median imputation for numeric errors
    price_median = cleaned["price_gbp"].median()
    cleaned["price_gbp"] = cleaned["price_gbp"].fillna(price_median)
    
    # 2. Rating mapping (1-5)
    def parse_rating(val):
        if not val or pd.isna(val):
            return 3 # median default
        return RATING_MAP.get(str(val).lower(), 3)
        
    cleaned["rating"] = cleaned["raw_rating"].apply(parse_rating)
    
    # 3. Availability boolean
    cleaned["in_stock"] = cleaned["raw_avail"].apply(
        lambda x: 1 if (x and "in stock" in str(x).lower()) else 0
    )
    
    # 4. Currency conversion using baseline fixed rate
    cleaned["price_inr"] = (cleaned["price_gbp"] * GBP_TO_INR_RATE).round(2)
    
    # 5. Drop temporary raw extraction fields
    cleaned = cleaned.drop(columns=["raw_price", "raw_rating", "raw_avail"])
    return cleaned

def init_database(db_path="zepto_catalog.db"):
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute("PRAGMA foreign_keys = ON;")
    
    cur.execute("""
    CREATE TABLE IF NOT EXISTS categories (
        category_id INTEGER PRIMARY KEY AUTOINCREMENT,
        category_name TEXT UNIQUE NOT NULL
    );
    """)
    
    cur.execute("""
    CREATE TABLE IF NOT EXISTS books (
        book_id INTEGER PRIMARY KEY AUTOINCREMENT,
        title TEXT NOT NULL,
        price_gbp REAL NOT NULL,
        price_inr REAL NOT NULL,
        rating INTEGER NOT NULL,
        in_stock INTEGER NOT NULL,
        category_id INTEGER NOT NULL,
        FOREIGN KEY (category_id) REFERENCES categories (category_id)
    );
    """)
    conn.commit()
    return conn

def populate_database(conn, df):
    cur = conn.cursor()
    # Normalize categories
    unique_categories = df["category"].unique()
    for cat in unique_categories:
        cur.execute("INSERT OR IGNORE INTO categories (category_name) VALUES (?)", (cat,))
    conn.commit()
    
    cat_map = pd.read_sql("SELECT category_name, category_id FROM categories", conn)
    merged = df.merge(cat_map, left_on="category", right_on="category_name")
    
    records = []
    for _, row in merged.iterrows():
        records.append((
            row["title"],
            float(row["price_gbp"]),
            float(row["price_inr"]),
            int(row["rating"]),
            int(row["in_stock"]),
            int(row["category_id"])
        ))
        
    cur.execute("DELETE FROM books;")
    cur.executemany("""
        INSERT INTO books (title, price_gbp, price_inr, rating, in_stock, category_id)
        VALUES (?, ?, ?, ?, ?, ?)
    """, records)
    conn.commit()

def run_queries_and_verify(conn, db_path):
    print("=" * 60)
    print("SQL QUERY EXECUTION AND CLAUSE DEMONSTRATIONS")
    print("=" * 60)

    queries = {
        "Q1 (SELECT, WHERE, ORDER BY, LIMIT)": """
            SELECT title, price_inr, rating 
            FROM books 
            WHERE in_stock = 1 
            ORDER BY price_inr DESC 
            LIMIT 5;
        """,
        "Q2 (DISTINCT)": """
            SELECT DISTINCT rating 
            FROM books 
            ORDER BY rating ASC;
        """,
        "Q3 (BETWEEN)": """
            SELECT title, price_gbp 
            FROM books 
            WHERE price_gbp BETWEEN 20.0 AND 30.0 
            ORDER BY price_gbp ASC 
            LIMIT 5;
        """,
        "Q4 (IN)": """
            SELECT title, rating 
            FROM books 
            WHERE rating IN (4, 5) 
            ORDER BY title ASC 
            LIMIT 5;
        """,
        "Q5 (JOIN, WHERE, ORDER BY, LIMIT)": """
            SELECT b.title, c.category_name, b.rating, b.price_inr
            FROM books b
            JOIN categories c ON b.category_id = c.category_id
            WHERE b.rating >= 4
            ORDER BY b.price_inr DESC
            LIMIT 10;
        """
    }

    for name, sql in queries.items():
        print(f"\n--- {name} ---")
        res = pd.read_sql_query(sql, conn)
        print(res.to_string(index=False))

    print("\n" + "=" * 60)
    print("VERIFICATION: pd.read_sql vs pd.merge EQUIVALENCE")
    print("=" * 60)
    
    # Approach A: pd.read_sql
    join_sql = """
        SELECT b.title, c.category_name, b.rating, b.price_inr
        FROM books b
        JOIN categories c ON b.category_id = c.category_id
        WHERE b.rating >= 4
        ORDER BY b.price_inr DESC
        LIMIT 10;
    """
    df_sql = pd.read_sql_query(join_sql, conn)

    # Approach B: pd.merge in memory
    df_books = pd.read_sql_table("books", f"sqlite:///{db_path}")
    df_cats = pd.read_sql_table("categories", f"sqlite:///{db_path}")

    merged_df = (
        pd.merge(df_books, df_cats, on="category_id")
        .query("rating >= 4")
        [["title", "category_name", "rating", "price_inr"]]
        .sort_values(by="price_inr", ascending=False)
        .head(10)
        .reset_index(drop=True)
    )

    print("\npd.read_sql Output:")
    print(df_sql.head())
    print("\npd.merge Output:")
    print(merged_df.head())

    # Structural check
    diff = df_sql.compare(merged_df)
    if diff.empty:
        print("\nEQUIVALENCE CONFIRMED: pd.read_sql and pd.merge produce identical tables.")
    else:
        print("\nDifferences detected:", diff)

if __name__ == "__main__":
    db_file = "zepto_catalog.db"
    print("Scraping books.toscrape.com...")
    raw_df = scrape_books(min_count=60)
    print(f"Scraped {len(raw_df)} books.")
    
    print("Cleaning fields and applying baseline conversion (1 GBP = 105.50 INR)...")
    cleaned_df = clean_data(raw_df)
    
    print(f"Initializing SQLite database: {db_file}...")
    connection = init_database(db_file)
    
    print("Populating relational tables...")
    populate_database(connection, cleaned_df)
    
    run_queries_and_verify(connection, db_file)
    connection.close()
